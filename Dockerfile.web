# syntax=docker/dockerfile:1
#
# Melos Web PWA（默认）
# -----------------------------------------------------------------------------
# 静态文件已在本机预编译到 prebuilt/web/，部署时不需要 Flutter SDK。
# 重建前端：./docker/build-web.sh
# 可选：Dockerfile.web.source 在 Docker 内从 Flutter 源码构建。
#
# 前端与后端同源：
#   浏览器 -> Nginx :80 -> /api/ -> api:3005 (会话网关)
#                                   -> 127.0.0.1:3006 (KuGouMusicApi)

FROM nginx:alpine

COPY prebuilt/web /usr/share/nginx/html
COPY docker/nginx-web.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
